[
  {
    "strName": "ENCHeatSVIRBustedStart",
    "strTitle": "Поимка",
    "strDesc": "Вас тащат на суд к военному судье Титана, оставив корабль и снаряжение.\nНа слушании вы можете умолять лишь о штрафе — 15 000 долларов, которые можно выплатить единовременно или в рассрочку, — или же вас отправят в тюрьму Вирджиния на год или два на каторжные работы.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatSVIRFineEnd",

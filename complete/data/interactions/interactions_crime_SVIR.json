  },
  {
    "strName": "ENCHeatSVIRFineEnd",
    "strTitle": "Просить о штрафе (Единовременная выплата)",
    "strDesc": "Будто они специально хотят, чтобы вы нарушали правила, чтобы содрать с вас больше штрафов.\nВы подписываете горы бумаг в тугих наручниках.\nЭто своего рода тюремное заключение. Тяжесть, свисающая у вас на шее.\nДобавлен новый штраф: 15 000 долларов.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatSVIRFineFinish"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
    "strRaiseUI": "SocialCombat",

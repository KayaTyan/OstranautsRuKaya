  },
  {
    "strName": "ENCHeatMHNGFineEnd",
    "strTitle": "Просить о штрафе (Единовременная выплата)",
    "strDesc": "Кажется, они хотят, чтобы вы нарушали правила, чтобы вымогать из вас больше штрафов.\nВы подписываете горы бумаг в тугих наручниках.\nЭто своего рода тюремный приговор. Ещё один груз, висящий у вас на шее.\nДобавлен новый штраф в размере 15 000 долларов.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatMHNGFineFinish"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
    "strRaiseUI": "SocialCombat",

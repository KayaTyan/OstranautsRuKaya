  },
  {
    "strName": "ENCHeatJATLFineEnd",
    "strTitle": "Просить о штрафе (Единым платежом)",
    "strDesc": "Словно они хотят, чтобы вы нарушали правила, чтобы содрать с вас больше штрафов.\nВы подписываете mountains of documentation в тугих наручниках.\nЭто тюремное наказание другого рода. Еще один груз, висящий у вас на шее.\nДобавлен новый штраф в размере $15 000.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatJATLFineFinish"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
    "strRaiseUI": "SocialCombat",
    "strSubUI": "Landscape01",

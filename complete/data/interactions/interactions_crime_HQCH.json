  {
    "strName": "ENCHeatHQCHFineEnd",
    "strTitle": "перевод: Попросить о штрафе (Единым платежом)",
    "strDesc": "Будто они хотят, чтобы вы нарушали правила, чтобы содрать с вас больше штрафов.\nВы подписываете горы бумаг в тугих наручниках.\nЭто тюремное приговорение иного рода. Ещё один груз, висящий у вас на шее.\nДобавлен новый штраф в размере 15 000 долларов.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatHQCHFineFinish"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
    "strRaiseUI": "SocialCombat",
    "strSubUI": "Landscape01",
    "strImage": "encounters/EncFirstUndockFees",
    "nLogging": 0,
    "bPause": true,

  },
  {
    "strName": "ENCHeatHQCHFineDebtEnd",
    "strTitle": "перевод: Попросить о штрафе (В рассрочку)",
    "strDesc": "перевод: Словно они хотят, чтобы вы нарушили правила, чтобы вогнать вас в ещё большую долговую кабалу с процентами.\nВы подписываете груду бумаг в тугих наручниках.\nЭто тюремное наказание другого рода. Ещё один груз, висящий у вас на шее.\nДобавлен новый долг в размере $15,000, платеж должен вноситься каждую смену.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatHQCHFineFinish"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",

    "strLedgerDef": "ENCHeatMVOLFinePublicDisorder",
    "aSocialNew": []
  },
  {
    "strName": "ENCHeatMVOLFineDebtEnd",
    "strTitle": "Просить о штрафе (В рассрочку)",
    "strDesc": "Словно они хотят, чтобы вы нарушали правила, чтобы глубже запутать вас в процентных выплатах.\nВы подписываете бесконечные стопки бумаг в тугих наручниках.\nЭто своего рода тюремное заключение. Ещё один груз, висящий у вас на шее.\nНовый долг в 15 000 долларов, с оплатой каждую смену.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatMVOLFineFinish"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
    "strRaiseUI": "SocialCombat",

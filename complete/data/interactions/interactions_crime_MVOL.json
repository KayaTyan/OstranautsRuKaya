  },
  {
    "strName": "ENCHeatMVOLFineEnd",
    "strTitle": "Просить о штрафе (Единовременная выплата)",
    "strDesc": "Словно они хотят, чтобы вы нарушали правила, чтобы вымогать из вас больше штрафов.\nВы подписываете бесконечные стопки бумаг в тугих наручниках.\nЭто своего рода тюремное заключение. Ещё один груз, висящий у вас на шее.\nНовый штраф: 15 000 долларов.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatMVOLFineFinish"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
    "strRaiseUI": "SocialCombat",
    "strSubUI": "Landscape01",
    "strImage": "encounters/EncFirstUndockFees",
    "nLogging": 0,
    "bPause": true,

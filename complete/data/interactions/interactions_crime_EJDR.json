  },
  {
    "strName": "ENCHeatEJDRFineEnd",
    "strTitle": "Просить о штрафе (Единым платежом)",
    "strDesc": "Так будто они хотят, чтобы вы нарушали правила, чтобы содрать с вас больше штрафов.\nВы подписываете груды бумаг в тугих наручниках.\nЭто тюремное заключение другого рода. Ещё одна тяжесть на вашей шее.\nДобавлен новый штраф в 15 000 долларов.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatEJDRFineFinish"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
